# Copie para .env e preencha.

# Porta do servidor
PORT=3000

# URL pública do site (sitemap, links compartilhados, meta tags)
SITE_URL=https://www.remaxagape.com.br

# Token que o CRM deve enviar no webhook (header X-Webhook-Token,
# Authorization: Bearer <token> ou ?token=<token> na URL).
# Gere um valor longo e aleatório, ex.: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_TOKEN=

# Alternativa: se o CRM assinar o corpo com HMAC-SHA256 (header X-Signature / X-Hub-Signature-256)
WEBHOOK_SECRET=

# Em produção, o webhook recusa chamadas se nenhum dos dois acima estiver definido
NODE_ENV=production
